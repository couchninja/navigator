[Unit]
Description=Navigator (LEGO Move Hub)
After=bluetooth.service dbus.service
Wants=bluetooth.service

[Service]
Type=simple
WorkingDirectory=@REPO_ROOT@
Environment=PATH=@PIXI_BIN@:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=PYTHONUNBUFFERED=1
ExecStart=@PIXI_BIN@/pixi run nav
Restart=on-failure
RestartSec=5
StandardOutput=append:@REPO_ROOT@/logs/navigator.log
StandardError=append:@REPO_ROOT@/logs/navigator.log

[Install]
WantedBy=default.target
